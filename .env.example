# Liquid Chat - Environment Configuration
APP_ENV=production
APP_DEBUG=false
SITE_URL=https://chat.example.com

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=liquid_chat
DB_USERNAME=liquid_user
DB_PASSWORD=your_secure_password_here

# Server Encryption Key (AES-256 32-byte Base64 key)
# Generate with: openssl rand -base64 32
APP_ENC_KEY=

# Web Push VAPID Settings
VAPID_SUBJECT=mailto:admin@example.com
